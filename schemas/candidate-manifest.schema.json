{
  "$comment": "由 app/src/shared/schemas 自动生成，不要手改。修改后运行 npm run gen:schemas。",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "candidateId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?![\\s\\S])"
    },
    "cat": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?![\\s\\S])"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "rejected"
      ]
    },
    "note": {
      "type": "string"
    },
    "assetLog": {
      "type": "object",
      "properties": {
        "generator": {
          "type": "string",
          "minLength": 1
        },
        "modelFiles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "workflow": {
          "type": "string",
          "minLength": 1
        },
        "prompt": {
          "type": "string"
        },
        "params": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "startPoseFrame": {
          "type": "string",
          "minLength": 1
        },
        "endPoseFrame": {
          "type": "string",
          "minLength": 1
        },
        "rawVideo": {
          "type": "string",
          "minLength": 1
        },
        "createdAt": {
          "type": "string",
          "allOf": [
            {
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            },
            {
              "pattern": "^[0-9T:.+Z-]+(?![\\s\\S])"
            }
          ]
        }
      },
      "required": [
        "generator",
        "modelFiles",
        "prompt",
        "params",
        "attempt",
        "startPoseFrame",
        "endPoseFrame",
        "rawVideo",
        "createdAt"
      ],
      "additionalProperties": false
    },
    "clip": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string"
        },
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?![\\s\\S])"
        },
        "variant": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "kind": {
          "type": "string",
          "enum": [
            "loop",
            "transition",
            "action"
          ]
        },
        "fromPose": {
          "type": "string",
          "enum": [
            "stand",
            "sit",
            "sleep",
            "dangle",
            "crouch",
            "airborne"
          ]
        },
        "toPose": {
          "type": "string",
          "enum": [
            "stand",
            "sit",
            "sleep",
            "dangle",
            "crouch",
            "airborne"
          ]
        },
        "optional": {
          "type": "boolean"
        },
        "video": {
          "type": "string",
          "pattern": "^(?!\\.{1,2}(?:\\/|$))[^/\\\\:\\u0000-\\u001f\\u007f]+(?:\\/(?!\\.{1,2}(?:\\/|$))[^/\\\\:\\u0000-\\u001f\\u007f]+)*(?![\\s\\S])"
        },
        "hitMask": {
          "type": "string",
          "pattern": "^(?!\\.{1,2}(?:\\/|$))[^/\\\\:\\u0000-\\u001f\\u007f]+(?:\\/(?!\\.{1,2}(?:\\/|$))[^/\\\\:\\u0000-\\u001f\\u007f]+)*(?![\\s\\S])"
        },
        "fps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "frameCount": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "width": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "height": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "footAnchors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            },
            "required": [
              "x",
              "y"
            ],
            "additionalProperties": false
          }
        },
        "mirrorable": {
          "type": "boolean"
        },
        "facing": {
          "type": "string",
          "enum": [
            "left",
            "right"
          ]
        },
        "speed": {
          "type": "number",
          "minimum": 0
        },
        "keypoints": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?![\\s\\S])"
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "x",
                    "y"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "soundStartFrame": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "schemaVersion",
        "name",
        "variant",
        "kind",
        "fromPose",
        "toPose",
        "optional",
        "video",
        "hitMask",
        "fps",
        "frameCount",
        "width",
        "height",
        "footAnchors",
        "mirrorable",
        "facing",
        "speed",
        "keypoints"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "candidateId",
    "cat",
    "status",
    "assetLog",
    "clip"
  ],
  "additionalProperties": false
}
