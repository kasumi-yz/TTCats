{
  "$comment": "由 app/src/shared/schemas 自动生成，不要手改。修改后运行 npm run gen:schemas。",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "cat": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?![\\s\\S])"
    },
    "candidateId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?![\\s\\S])"
    },
    "candidateManifestSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
    },
    "source": {
      "type": "object",
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        "width": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "height": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "fps": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 120
        },
        "frameCount": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "sha256",
        "width",
        "height",
        "fps",
        "frameCount"
      ],
      "additionalProperties": false
    },
    "kind": {
      "type": "string",
      "enum": [
        "loop",
        "transition",
        "action"
      ]
    },
    "selection": {
      "type": "object",
      "properties": {
        "trimStart": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "trimEnd": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "loopStart": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "loopEnd": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "footAnchors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            },
            "required": [
              "x",
              "y"
            ],
            "additionalProperties": false
          }
        },
        "keypoints": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?![\\s\\S])"
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "x",
                    "y"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "speed": {
          "type": "number",
          "minimum": 0
        },
        "soundStartFrame": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "trimStart",
        "trimEnd",
        "loopStart",
        "loopEnd",
        "footAnchors",
        "keypoints",
        "speed"
      ],
      "additionalProperties": false
    },
    "accepted": {
      "type": "boolean"
    },
    "note": {
      "type": "string"
    },
    "manualSeconds": {
      "type": "number",
      "minimum": 0
    }
  },
  "required": [
    "schemaVersion",
    "cat",
    "candidateId",
    "candidateManifestSha256",
    "source",
    "kind",
    "selection",
    "accepted",
    "note",
    "manualSeconds"
  ],
  "additionalProperties": false
}
